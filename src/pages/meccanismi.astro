---
/**
 * I meccanismi ricorrenti.
 *
 * Il testo di questa pagina NON si modifica qui: sta in src/dati/meccanismi.json
 * ed è modificabile dal pannello, in Impostazioni → Pagina "I meccanismi".
 * Qui c'è solo l'impaginazione.
 *
 * Gli articoli elencati sotto ogni stadio vengono letti dalla collezione
 * tramite il nome del file, così un titolo che cambia non lascia un link
 * rotto e una bozza compare da sola il giorno in cui la pubblichi.
 */
import Base from '../layouts/Base.astro';
import { articoliPubblicati } from '../utils/articoli';
import { MECCANISMI } from '../utils/dati';
import { rendiMarkdown, rendiMarkdownInLinea } from '../utils/markdown';

const articoli = await articoliPubblicati();
const perSlug = new Map(articoli.map((a) => [a.id.replace(/\.mdx?$/, ''), a]));

const apertura = await rendiMarkdown(MECCANISMI.apertura);
const dopoCatena = await rendiMarkdown(MECCANISMI.dopoCatena);
const domandeIntro = await rendiMarkdown(MECCANISMI.domandeIntro);
const chiusura = await rendiMarkdown(MECCANISMI.chiusura);

const stadi = await Promise.all(
	MECCANISMI.stadi.map(async (s) => ({
		...s,
		sintesiHtml: await rendiMarkdown(s.sintesi),
		articoli: s.articoli.map((slug) => perSlug.get(slug)).filter(Boolean),
	}))
);

const sezioni = await Promise.all(
	MECCANISMI.sezioni.map(async (s) => ({ titolo: s.titolo, html: await rendiMarkdown(s.testo) }))
);

const domande = await Promise.all(
	MECCANISMI.domande.map(async (d) => ({
		domandaHtml: await rendiMarkdownInLinea(d.domanda),
		notaHtml: await rendiMarkdownInLinea(d.nota),
	}))
);
---

<Base
	titolo={MECCANISMI.titolo}
	descrizione={MECCANISMI.descrizione}
	noindex={MECCANISMI.bozza}
>
	<div class="contenitore">
		<div class="pagina-testuale">
			{
				MECCANISMI.bozza && (
					<div class="avviso-anteprima">
						<strong>Anteprima</strong> — questa pagina è una bozza: non è nel menu e non è
						visibile ai motori di ricerca.
					</div>
				)
			}

			<h1 class="articolo__titolo">{MECCANISMI.titolo}</h1>

			<div class="corpo">
				<Fragment set:html={apertura} />

				<p class="catena">
					{
						MECCANISMI.catena.map((passo, i) => (
							<>
								{i > 0 && <span aria-hidden="true">→</span>}
								<span>{passo}</span>
							</>
						))
					}
				</p>

				<Fragment set:html={dopoCatena} />

				{
					stadi.map((s, i) => (
						<section class="meccanismo">
							<p class="meccanismo__ruolo">
								<span class="meccanismo__numero">{i + 1}</span>
								{s.ruolo}
							</p>
							<h2>{s.titolo}</h2>
							<Fragment set:html={s.sintesiHtml} />
							{s.articoli.length > 0 && (
								<ul class="meccanismo__elenco">
									{s.articoli.map((a: any) => (
										<li>
											<a href={`/${a.id.replace(/\.mdx?$/, '')}`}>{a.data.titolo}</a>
										</li>
									))}
								</ul>
							)}
						</section>
					))
				}

				{
					sezioni.map((s) => (
						<>
							<h2>{s.titolo}</h2>
							<Fragment set:html={s.html} />
						</>
					))
				}

				{
					domande.length > 0 && (
						<>
							<h2>{MECCANISMI.domandeTitolo}</h2>
							<Fragment set:html={domandeIntro} />
							<ol class="domande">
								{domande.map((d) => (
									<li>
										<strong set:html={d.domandaHtml} />
										{d.notaHtml && <Fragment set:html={` ${d.notaHtml}`} />}
									</li>
								))}
							</ol>
						</>
					)
				}

				<Fragment set:html={chiusura} />
			</div>
		</div>
	</div>
</Base>

<style>
	.meccanismo {
		margin-top: 2.75rem;
	}

	.meccanismo h2 {
		margin-top: 0.15rem;
	}

	/* Etichetta dello stadio: dice a che punto della catena siamo. */
	.meccanismo__ruolo {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--testo-tenue);
	}

	.meccanismo__numero {
		flex: none;
		color: var(--accento);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	.meccanismo__elenco {
		margin-top: 0.75rem;
		padding-left: 1.1rem;
	}

	.meccanismo__elenco li {
		margin-bottom: 0.35rem;
	}

	/* Le tre domande: numerate in accento, una per stadio della catena. */
	.domande {
		margin: 1.25rem 0;
		padding-left: 1.6rem;
	}

	.domande li {
		margin-bottom: 0.9rem;
		padding-left: 0.25rem;
	}

	.domande li::marker {
		color: var(--accento);
		font-weight: 700;
	}

	/* La sequenza in testa alla pagina: si legge in un colpo d'occhio. */
	.catena {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		padding: 1rem 1.15rem;
		border: 1px solid var(--bordo);
		border-radius: 8px;
		background: var(--sfondo-alt);
		font-family: var(--serif);
	}

	.catena span:nth-child(odd) {
		font-weight: 600;
	}

	.catena span:nth-child(even) {
		color: var(--accento);
	}
</style>
