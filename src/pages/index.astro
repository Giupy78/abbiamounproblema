---
import Base from '../layouts/Base.astro';
import SchedaArticolo from '../components/SchedaArticolo.astro';
import CartinaItalia from '../components/CartinaItalia.astro';
import { SITO } from '../config';
import { articoliPubblicati } from '../utils/articoli';

const articoli = await articoliPubblicati();

// Se un articolo è segnato "inEvidenza" va in cima, altrimenti ci va il più
// recente. Gli altri seguono in ordine cronologico.
const inEvidenza = articoli.find((a: any) => a.data.inEvidenza) ?? articoli[0];
const restanti = articoli.filter((a: any) => a.id !== inEvidenza?.id).slice(0, 12);
---

<Base titolo={SITO.nome} descrizione={SITO.descrizione}>
	{/*
		L'apertura porta l'unico <h1> della homepage: prima non ce n'era
		nessuno, e per i motori di ricerca era una lacuna.
	*/}
	<section class="apertura">
		<div class="contenitore apertura__interno">
			<div class="apertura__testo">
				<h1 class="apertura__titolo">I problemi dell'Italia, uno alla volta</h1>
				<p class="apertura__sommario">{SITO.descrizione}</p>
				<div class="apertura__inviti">
					<a class="apertura__invito" href="/proposte">Le proposte</a>
					<a class="apertura__invito apertura__invito--secondario" href="/diamoci-un-metodo">
						Come lavoriamo
					</a>
				</div>
			</div>

			<div class="apertura__mappa">
				<CartinaItalia />
			</div>
		</div>
	</section>

	<div class="contenitore">
		{
			articoli.length === 0 ? (
				<div class="pagina-testuale">
					<h2>Non ci sono ancora articoli</h2>
					<p>
						Per pubblicare il primo pezzo usa il pannello di scrittura su
						<a href="/admin">/admin</a>, oppure crea un file in
						<code>src/contenuti/articoli/</code>. Le istruzioni sono in
						<code>COME-PUBBLICARE.md</code>.
					</p>
				</div>
			) : (
				<div style="padding-block: 3rem 4rem">
					{inEvidenza && (
						<div style="margin-bottom: 3rem">
							<SchedaArticolo articolo={inEvidenza} evidenza />
						</div>
					)}

					{restanti.length > 0 && (
						<>
							<h2 class="anno-archivio" style="margin-top:0">Gli altri articoli</h2>
							<ul class="elenco-articoli">
								{restanti.map((articolo: any) => (
									<li>
										<SchedaArticolo articolo={articolo} />
									</li>
								))}
							</ul>
						</>
					)}

					{articoli.length > 13 && (
						<p style="margin-top:3rem">
							<a href="/archivio">Vedi tutti gli articoli nell'archivio →</a>
						</p>
					)}
				</div>
			)
		}
	</div>
</Base>
