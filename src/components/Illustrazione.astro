---
/**
 * Illustrazioni di apertura degli articoli.
 *
 * Disegnate qui, non scaricate: nessun problema di licenza, nessuna
 * somiglianza con altri siti, peso irrisorio e nitidezza a qualsiasi
 * dimensione. Usano i colori del tema, quindi funzionano da sole sia in
 * chiaro sia in scuro.
 *
 * Criterio sul colore: si usa per significare, non per decorare.
 * Rosso il problema, verde ciò che funziona o il denaro, toni caldi il
 * fuoco. Sono gli stessi colori della cartina e delle etichette di stato,
 * così la serie appartiene al sito invece di sembrarci incollata sopra.
 *
 * Per aggiungerne una: disegna il caso qui sotto e aggiungi il nome
 * all'elenco ILLUSTRAZIONI in src/config.ts.
 */

interface Props {
	nome: string;
	/** Descrizione per chi non vede l'immagine. Vuota se puramente decorativa. */
	descrizione?: string;
	class?: string;
}

const { nome, descrizione, class: classe } = Astro.props;

/** Banconote che cadono nell'imbuto: posizione e inclinazione. */
const BANCONOTE = [
	{ x: 116, y: 8, r: -14 },
	{ x: 186, y: 2, r: 8 },
	{ x: 256, y: 10, r: -6 },
	{ x: 152, y: 34, r: 6 },
	{ x: 222, y: 32, r: -10 },
	{ x: 292, y: 30, r: 12 },
];
---

<div class:list={['illustrazione', classe]}>
	<svg
		viewBox="0 0 480 180"
		xmlns="http://www.w3.org/2000/svg"
		role={descrizione ? 'img' : 'presentation'}
		aria-label={descrizione}
		aria-hidden={descrizione ? undefined : 'true'}
		focusable="false"
	>
		{
			nome === 'metodo' && (
				<g>
					{/* Il groviglio del dibattito in rosso, la via d'uscita in verde:
					    il colore racconta da solo "dal problema alla proposta". */}
					<path
						class="tratto rosso"
						d="M40 90c0-26 34-30 34-6s-38 22-38-6 44-34 52-4-30 46-30 10 40-30 56-2-24 44-8 16 34-42 60-8"
					/>
					<circle class="pieno rosso-pieno" cx="228" cy="96" r="7" />
					<path class="tratto verde" d="M236 96h176" />
					<path class="tratto verde" d="M396 78l20 18-20 18" />
				</g>
			)
		}

		{
			nome === 'imbuto' && (
				<g>
					{/* Entra denaro in quantità, esce una monetina: il costo che
					    la burocrazia consuma per strada. */}
					{BANCONOTE.map((b) => (
						<g transform={`rotate(${b.r} ${b.x + 22} ${b.y + 12})`}>
							<rect class="banconota" x={b.x} y={b.y} width="44" height="24" rx="3" />
							<circle class="banconota-segno" cx={b.x + 22} cy={b.y + 12} r="6" />
						</g>
					))}

					<path class="tratto" d="M104 74h232l-90 48v34h-52v-34z" />

					<circle class="pieno verde-pieno" cx="220" cy="166" r="9" />
					<text class="euro" x="264" y="174">€</text>
				</g>
			)
		}

		{
			nome === 'pila' && (
				<g>
					{/* La pila che ricresce, e il gesto che la brucia.
					    Fiamma a tre toni caldi: fuori rosso, poi ocra, dentro giallo. */}
					<rect class="tratto" x="96" y="140" width="200" height="18" rx="3" />
					<rect class="tratto" x="106" y="116" width="180" height="18" rx="3" />
					<rect class="tratto" x="116" y="92" width="160" height="18" rx="3" />
					<rect class="tratto" x="126" y="68" width="140" height="18" rx="3" />
					<rect class="tratto" x="136" y="44" width="120" height="18" rx="3" />
					<path
						class="pieno fiamma-esterna"
						d="M348 40c20 34 40 50 40 74 0 24-18 40-40 40s-40-16-40-40c0-24 20-40 40-74z"
					/>
					<path
						class="pieno fiamma-media"
						d="M348 74c13 23 26 33 26 49 0 16-12 26-26 26s-26-10-26-26c0-16 13-26 26-49z"
					/>
					<path
						class="pieno fiamma-interna"
						d="M348 108c7 12 13 18 13 27 0 9-6 14-13 14s-13-5-13-14c0-9 6-15 13-27z"
					/>
				</g>
			)
		}

		{
			nome === 'palazzina' && (
				<g>
					{/* Una palazzina qualunque, e la cartella con il bollo rosso
					    che le arriva addosso. */}
					<path class="tratto" d="M120 158V54l70-32 70 32v104" />
					{[
						[146, 74],
						[186, 74],
						[226, 74],
						[146, 106],
						[226, 106],
					].map(([x, y]) => (
						<rect class="tratto" x={x} y={y} width="24" height="22" rx="2" />
					))}
					<rect class="pieno accento" x="186" y="106" width="24" height="22" rx="2" />
					<rect class="tratto" x="174" y="130" width="32" height="28" rx="2" />

					<rect class="tratto riempito" x="300" y="46" width="86" height="112" rx="4" />
					<path class="tratto" d="M318 74h50M318 94h50M318 114h32" />
					<text class="euro euro--rosso" x="330" y="146">€</text>
				</g>
			)
		}

		{
			nome === 'bilancia' && (
				<g>
					{/* Il costo su un piatto, il risultato sull'altro: la bilancia
					    pende dalla parte di chi paga. */}
					<path class="tratto" d="M240 40v112" />
					<path class="tratto" d="M204 158h72l-12-14h-48z" />
					<circle class="pieno accento" cx="240" cy="36" r="7" />

					{/* Trave inclinata: a sinistra scende, a destra sale. */}
					<path class="tratto" d="M124 74l232-24" />

					{/* Piatto sinistro: il costo, che pesa */}
					<path class="tratto" d="M124 74v22" />
					<path class="tratto" d="M86 96h76l-16 30H102z" />
					<text class="euro euro--piatto" x="111" y="122">€</text>

					{/* Piatto destro: il risultato climatico, che pesa molto meno */}
					<path class="tratto" d="M356 50v22" />
					<path class="tratto" d="M318 72h76l-16 30h-44z" />
					<path
						class="pieno tenue"
						d="M333 96c-5 0-9-4-9-9s4-9 9-9c1-6 6-10 12-10 5 0 9 3 11 7 1-1 3-1 4-1 5 0 9 4 9 9s-4 9-9 9z"
					/>
				</g>
			)
		}

		{
			nome === 'catena' && (
				<g>
					{/* Ogni anello e legittimo. Ma piu la catena si allunga, meno
					    il segnale arriva — fino a spezzarsi. */}
					{[
						{ x: 78, o: 1 },
						{ x: 140, o: 0.82 },
						{ x: 202, o: 0.64 },
						{ x: 264, o: 0.46 },
						{ x: 326, o: 0.3 },
					].map((a) => (
						<ellipse class="tratto" cx={a.x} cy="90" rx="38" ry="22" opacity={a.o} />
					))}

					{/* L'ultimo anello non tiene piu */}
					<ellipse
						class="tratto rosso anello-rotto"
						cx="392"
						cy="90"
						rx="38"
						ry="22"
					/>
				</g>
			)
		}

		{
			nome === 'crepa' && (
				<g>
					{/*
					 * La scossa che parte da Wall Street e arriva a Roma.
					 * A sinistra i grattacieli fitti con l'epicentro, in mezzo le
					 * onde d'urto e il grafico che precipita, a destra il Colosseo
					 * col profilo mozzato. Il terreno spaccato attraversa tutto.
					 *
					 * Le sfumature hanno id con prefisso "crepa-" per non entrare
					 * in conflitto se un giorno due illustrazioni finiscono nella
					 * stessa pagina.
					 */}
					<defs>
						<linearGradient id="crepa-cielo" x1="0" y1="0" x2="1" y2="0">
							<stop offset="0%" stop-color="#c0392b" stop-opacity="0.20" />
							<stop offset="50%" stop-color="#d98324" stop-opacity="0.07" />
							<stop offset="100%" stop-color="#c0392b" stop-opacity="0.13" />
						</linearGradient>
						<linearGradient id="crepa-pal" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#5f5b54" />
							<stop offset="100%" stop-color="#35322d" />
						</linearGradient>
					</defs>

					<rect x="0" y="0" width="480" height="180" fill="url(#crepa-cielo)" />

					{[0, 1, 2, 3, 4].map((i) => (
						<path
							d={`M${186 + i * 26} 70 Q ${198 + i * 30} 120 ${186 + i * 26} 170`}
							fill="none"
							stroke="#c0392b"
							stroke-width={2.4 - i * 0.4}
							opacity={0.3 - i * 0.052}
						/>
					))}

					<path
						d="M190 28 L224 40 L252 24 L288 52 L322 38 L358 70 L396 56 L436 94"
						fill="none"
						stroke="#c0392b"
						stroke-width="3.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
					<circle class="pieno rosso-pieno" cx="436" cy="94" r="5" />

					{[
						{ x: 22, w: 20, h: 82 },
						{ x: 46, w: 16, h: 58 },
						{ x: 66, w: 24, h: 100 },
						{ x: 94, w: 17, h: 70 },
						{ x: 115, w: 22, h: 88 },
					].map((b) => (
						<g>
							<rect x={b.x} y={152 - b.h} width={b.w} height={b.h} fill="url(#crepa-pal)" />
							{Array.from({ length: Math.floor(b.h / 15) }, (_, r) =>
								Array.from({ length: Math.max(1, Math.floor(b.w / 9)) }, (_, c) => (
									<rect
										x={b.x + 4 + c * 9}
										y={152 - b.h + 8 + r * 15}
										width="3.5"
										height="5"
										fill="#edc14a"
										opacity={(r * 7 + c * 3) % 5 > 2 ? 0.6 : 0.14}
									/>
								)),
							)}
						</g>
					))}

					{[10, 20, 32].map((r, i) => (
						<circle
							cx="78"
							cy="42"
							r={r}
							fill="none"
							stroke="#c0392b"
							stroke-width="2.5"
							opacity={0.72 - i * 0.22}
						/>
					))}
					<circle class="pieno rosso-pieno" cx="78" cy="42" r="5" />

					<g transform="translate(396 152)">
						<path d="M-62 0 L-62 -58 Q-62 -74 -40 -77 L-4 -77 L-4 0 Z" fill="url(#crepa-pal)" />
						<path d="M-4 -77 L-4 -44 L12 -44 L12 0 L-4 0 Z" fill="url(#crepa-pal)" />
						<path d="M12 -44 Q36 -42 46 -28 L52 0 L12 0 Z" fill="url(#crepa-pal)" />

						{[-56, -42, -28, -14].map((ax) => (
							<g>
								<path
									d={`M${ax} -8 L${ax} -24 Q${ax + 6} -31 ${ax + 12} -24 L${ax + 12} -8 Z`}
									fill="#35322d"
									opacity="0.62"
								/>
								<path
									d={`M${ax} -32 L${ax} -46 Q${ax + 6} -53 ${ax + 12} -46 L${ax + 12} -32 Z`}
									fill="#35322d"
									opacity="0.5"
								/>
								<path
									d={`M${ax} -54 L${ax} -66 Q${ax + 6} -72 ${ax + 12} -66 L${ax + 12} -54 Z`}
									fill="#35322d"
									opacity="0.38"
								/>
							</g>
						))}

						{[16, 30].map((ax) => (
							<path
								d={`M${ax} -8 L${ax} -24 Q${ax + 6} -31 ${ax + 12} -24 L${ax + 12} -8 Z`}
								fill="#35322d"
								opacity="0.5"
							/>
						))}
					</g>

					<path
						d="M0 152 L118 152 L148 160 L180 150 L212 164 L246 152 L284 166 L320 153 L358 167 L396 154 L434 165 L480 154 L480 180 L0 180 Z"
						fill="#35322d"
					/>
					<path
						d="M118 152 L148 160 L180 150 L212 164 L246 152 L284 166 L320 153 L358 167 L396 154 L434 165"
						fill="none"
						stroke="#c0392b"
						stroke-width="2.5"
						opacity="0.75"
					/>
				</g>
			)
		}

		{
			nome === 'calendario' && (
				<g>
					{/* Il tempo che scade: verde finché la norma vive, rosso il giorno
					    in cui decade da sola. */}
					<rect class="tratto riempito" x="150" y="46" width="180" height="112" rx="6" />
					<path class="tratto" d="M150 80h180" />
					<path class="tratto" d="M186 32v28M294 32v28" />
					{[
						[186, 104],
						[222, 104],
						[258, 104],
						[186, 132],
						[222, 132],
					].map(([x, y]) => (
						<circle class="pieno verde-pieno tenue" cx={x} cy={y} r="6" />
					))}
					<circle class="pieno rosso-pieno" cx="294" cy="104" r="11" />
					<path class="tratto rosso" d="M282 124l24 24M306 124l-24 24" />
				</g>
			)
		}
	</svg>
</div>

<style>
	.illustrazione {
		background: var(--sfondo-alt);
		border: 1px solid var(--bordo);
		border-radius: 8px;
		padding: 0.5rem;
		color: var(--testo-tenue);
	}

	.illustrazione svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.tratto {
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.riempito {
		fill: var(--sfondo);
	}

	.pieno {
		fill: currentColor;
		stroke: none;
	}

	.tenue {
		opacity: 0.45;
	}

	.accento {
		fill: var(--accento);
	}

	/* --- colori che significano --- */

	.rosso {
		stroke: #c0392b;
	}

	.rosso-pieno {
		fill: #c0392b;
	}

	.verde {
		stroke: #1a7a4c;
	}

	.verde-pieno {
		fill: #1a7a4c;
	}

	.banconota {
		fill: #1a7a4c;
		fill-opacity: 0.16;
		stroke: #1a7a4c;
		stroke-width: 2.5;
	}

	.banconota-segno {
		fill: #1a7a4c;
	}

	.euro {
		fill: #1a7a4c;
		font-family: var(--serif);
		font-size: 34px;
		font-weight: 700;
	}

	.euro--rosso {
		fill: #c0392b;
	}

	/* Dentro il piatto della bilancia serve piu piccolo, altrimenti sborda. */
	.euro--piatto {
		font-size: 27px;
	}

	/* L'anello interrotto: il tratteggio racconta la rottura senza
	   bisogno di disegnare due archi separati. */
	.anello-rotto {
		stroke-dasharray: 26 18;
	}

	.fiamma-esterna {
		fill: #c0392b;
	}

	.fiamma-media {
		fill: #d98324;
	}

	.fiamma-interna {
		fill: #edc14a;
	}

	/* Sul fondo scuro rosso e verde vanno schiariti per restare leggibili. */
	:global(:root[data-tema='scuro']) .rosso,
	:global(:root[data-tema='scuro']) .fiamma-esterna {
		stroke: #d9564b;
	}

	:global(:root[data-tema='scuro']) .rosso-pieno,
	:global(:root[data-tema='scuro']) .fiamma-esterna {
		fill: #d9564b;
	}

	:global(:root[data-tema='scuro']) .verde,
	:global(:root[data-tema='scuro']) .banconota {
		stroke: #3aa971;
	}

	:global(:root[data-tema='scuro']) .verde-pieno,
	:global(:root[data-tema='scuro']) .banconota-segno,
	:global(:root[data-tema='scuro']) .euro,
	:global(:root[data-tema='scuro']) .banconota {
		fill: #3aa971;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-tema='chiaro'])) .rosso,
		:global(:root:not([data-tema='chiaro'])) .fiamma-esterna {
			stroke: #d9564b;
		}

		:global(:root:not([data-tema='chiaro'])) .rosso-pieno,
		:global(:root:not([data-tema='chiaro'])) .fiamma-esterna {
			fill: #d9564b;
		}

		:global(:root:not([data-tema='chiaro'])) .verde,
		:global(:root:not([data-tema='chiaro'])) .banconota {
			stroke: #3aa971;
		}

		:global(:root:not([data-tema='chiaro'])) .verde-pieno,
		:global(:root:not([data-tema='chiaro'])) .banconota-segno,
		:global(:root:not([data-tema='chiaro'])) .euro,
		:global(:root:not([data-tema='chiaro'])) .banconota {
			fill: #3aa971;
		}
	}
</style>
